<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- New stages are created once (noupdate), so later edits are never overwritten. -->
    <data noupdate="1">
        <record id="crm_stage_discussion" model="crm.stage">
            <field name="name">Discussion</field>
            <field name="sequence">4</field>
            <field name="color">3</field>
        </record>
        <record id="crm_stage_po" model="crm.stage">
            <field name="name">PO</field>
            <field name="sequence">5</field>
            <field name="color">7</field>
        </record>
    </data>
    <!-- Functions are skipped inside noupdate blocks, so this sits outside. -->
    <function model="crm.stage" name="_setup_kep_pipeline"/>
</odoo>
