<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_employee" model="res.groups">
        <field name="name">HR Access: Employee</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hr_department_manager" model="res.groups">
        <field name="name">HR Access: Department Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_employee')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_manufacturing_worker" model="res.groups">
        <field name="name">HR Access: Manufacturing Worker</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_employee'))]"/>
    </record>

    <record id="group_hr_officer" model="res.groups">
        <field name="name">HR Access: HR Officer</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_employee')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_manager" model="res.groups">
        <field name="name">HR Access: HR Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_officer')), (4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="group_hr_executive" model="res.groups">
        <field name="name">HR Access: CEO / Managing Director</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_manager'))]"/>
    </record>
</odoo>
