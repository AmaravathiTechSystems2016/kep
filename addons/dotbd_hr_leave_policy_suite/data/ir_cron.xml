<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_generate_leave_policy_allocations" model="ir.cron">
        <field name="name">Generate Leave Policy Allocations</field>
        <field name="model_id" ref="model_attendance_leave_policy"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_missing_allocations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_refresh_leave_balances" model="ir.cron">
        <field name="name">Refresh Leave Balances</field>
        <field name="model_id" ref="model_attendance_leave_balance"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_leave_balances()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
    </record>
</odoo>
