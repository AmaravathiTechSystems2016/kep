<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_leave_type_form_inherit_support_days" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.support.days</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <field name="support_document" position="after">
                <field name="support_document_after_days"
                       invisible="not support_document"
                       placeholder="e.g. 3"/>
            </field>
        </field>
    </record>
</odoo>

