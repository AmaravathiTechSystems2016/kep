<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_leave_view_form_inherit_approval_tracking" model="ir.ui.view">
        <field name="name">hr.leave.form.approval.tracking</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='hr_leave_stats']" position="after">
                <group string="Approval Tracking">
                    <field name="approval_status_info" readonly="1"/>
                    <field name="create_date" string="Submitted On" readonly="1"/>
                    <field name="first_approver_id" string="Department Manager" readonly="1"/>
                    <field name="first_approval_at" readonly="1"/>
                    <field name="second_approver_id" string="HR Approver" readonly="1"/>
                    <field name="final_approval_at" readonly="1"/>
                    <field name="refused_at" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_tree_inherit_approval_tracking" model="ir.ui.view">
        <field name="name">hr.leave.list.approval.tracking</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="approval_status_info" string="Pending With" optional="show"/>
                <field name="first_approver_id" string="Department Manager" optional="hide"/>
                <field name="first_approval_at" optional="hide"/>
                <field name="second_approver_id" string="HR Approver" optional="hide"/>
                <field name="final_approval_at" optional="hide"/>
                <field name="refused_at" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="hr_leave_view_form_dashboard_inherit_probation_types" model="ir.ui.view">
        <field name="name">hr.leave.view.form.dashboard.inherit.probation.types</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_dashboard"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="domain">['|', ('probation_allowed_type', '=', True), '|', ('requires_allocation', '=', False), '&amp;', ('has_valid_allocation', '=', True), '|', ('allows_negative', '=', True), '&amp;', ('virtual_remaining_leaves', '&gt;', 0), ('allows_negative', '=', False)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_form_dashboard_inherit_request_apply_in" model="ir.ui.view">
        <field name="name">hr.leave.view.form.dashboard.inherit.request.apply.in</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_dashboard"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <div class="w-100 mt-2">
                    <label for="request_apply_in" string="Apply In" class="o_form_label"/>
                    <field name="request_apply_in" widget="selection" readonly="state != 'confirm'" options="{'no_open': True}" class="w-100"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
