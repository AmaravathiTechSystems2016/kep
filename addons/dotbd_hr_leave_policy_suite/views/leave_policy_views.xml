<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_attendance_leave_policy" model="ir.actions.act_window">
        <field name="name">Leave Policies</field>
        <field name="res_model">attendance.leave.policy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a leave policy for each employee category.</p>
        </field>
    </record>

    <record id="view_attendance_leave_policy_tree" model="ir.ui.view">
        <field name="name">attendance.leave.policy.list</field>
        <field name="model">attendance.leave.policy</field>
        <field name="arch" type="xml">
            <list string="Leave Policies" default_order="company_id, attendance_category, name">
                <field name="name"/>
                <field name="company_id"/>
                <field name="attendance_category"/>
                <field name="employee_count" string="Employees"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_leave_policy_form" model="ir.ui.view">
        <field name="name">attendance.leave.policy.form</field>
        <field name="model">attendance.leave.policy</field>
        <field name="arch" type="xml">
            <form string="Leave Policy">
                <header>
                    <button name="action_generate_yearly_allocations"
                            type="object"
                            string="Generate Yearly Allocations"
                            class="oe_highlight"/>
                    <button name="action_refresh_leave_balances"
                            type="object"
                            string="Refresh Leave Balances"/>
                    <button name="action_rebuild_policy_lines"
                            type="object"
                            string="Rebuild Policy Lines"
                            confirm="This will replace the current policy lines with the standard lines from existing leave types. Continue?"/>
                    <button name="action_reset_generated_allocations"
                            type="object"
                            string="Reset Allocations"
                            confirm="This will remove all allocations generated by this policy. Continue?"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Factory Worker Leave Policy"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="attendance_category"/>
                            <field name="earned_leave_min_service_months"/>
                            <field name="maternity_min_worked_days_last_12_months"/>
                            <field name="new_joiner_service_months_limit"/>
                            <field name="new_joiner_monthly_leave_limit"/>
                        </group>
                        <group>
                            <field name="employee_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Leave Rules">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_leave_type_name" string="Leave Type"/>
                                    <field name="allocation_mode"/>
                                    <field name="gender_applicability" optional="show"/>
                                    <field name="annual_days"/>
                                    <field name="notes"/>
                                    <field name="active" optional="show"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="display_leave_type_name" readonly="1"/>
                                            <field name="leave_type_id"/>
                                            <field name="gender_applicability"/>
                                            <field name="allocation_mode"/>
                                            <field name="annual_days"/>
                                            <field name="working_days_per_leave" invisible="allocation_mode != 'earned'"/>
                                            <field name="carry_forward_enabled" invisible="allocation_mode != 'earned'"/>
                                            <field name="carry_forward_limit_days" invisible="allocation_mode != 'earned' or not carry_forward_enabled"/>
                                            <field name="carry_forward_total_limit_days" invisible="allocation_mode != 'earned'"/>
                                            <field name="earned_days_per_unit" invisible="allocation_mode != 'earned'"/>
                                            <field name="encash_on_exit" invisible="allocation_mode != 'earned'"/>
                                            <field name="comp_off_days_per_worked_day" invisible="allocation_mode != 'comp_off'"/>
                                            <field name="notes"/>
                                            <field name="active"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_attendance_leave_policy_search" model="ir.ui.view">
        <field name="name">attendance.leave.policy.search</field>
        <field name="model">attendance.leave.policy</field>
        <field name="arch" type="xml">
            <search string="Search Leave Policies">
                <field name="name"/>
                <field name="company_id"/>
                <field name="attendance_category"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                <filter string="Category" name="group_category" context="{'group_by': 'attendance_category'}"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_attendance_leave_policy_root"
              name="Leave Policy Setup"
              parent="hr_holidays.menu_hr_holidays_configuration"
              sequence="40"
              groups="hr_holidays.group_hr_holidays_user"/>
    <menuitem id="menu_attendance_leave_policy"
              name="Leave Policies"
              parent="menu_attendance_leave_policy_root"
              action="action_attendance_leave_policy"
              sequence="1"
              groups="hr_holidays.group_hr_holidays_user"/>
</odoo>
