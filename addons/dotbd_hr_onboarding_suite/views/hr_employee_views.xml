<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_onboarding" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.onboarding</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action" name="%(dotbd_hr_onboarding_suite.action_hr_employee_onboarding)d" icon="fa-check-square-o">
                    <field name="onboarding_count" widget="statinfo" string="Onboarding"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

