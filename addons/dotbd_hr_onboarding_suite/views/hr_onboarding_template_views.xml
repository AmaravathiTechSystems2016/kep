<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_onboarding_template_tree" model="ir.ui.view">
        <field name="name">hr.onboarding.template.list</field>
        <field name="model">hr.onboarding.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_category"/>
                <field name="company_id"/>
                <field name="line_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_onboarding_template_form" model="ir.ui.view">
        <field name="name">hr.onboarding.template.form</field>
        <field name="model">hr.onboarding.template</field>
        <field name="arch" type="xml">
            <form string="Onboarding Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="employee_category"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="line_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Template Steps">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="step_type"/>
                                    <field name="required"/>
                                    <field name="responsible_role"/>
                                    <field name="duration_days"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_onboarding_template" model="ir.actions.act_window">
        <field name="name">Onboarding Templates</field>
        <field name="res_model">hr.onboarding.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
