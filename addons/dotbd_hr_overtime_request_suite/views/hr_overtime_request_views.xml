<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_overtime_request_tree" model="ir.ui.view">
        <field name="name">hr.overtime.request.list</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <list string="Overtime Requests">
                <field name="name"/>
                <field name="request_date"/>
                <field name="overtime_date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="attendance_category"/>
                <field name="requested_hours"/>
                <field name="approved_hours"/>
                <field name="state"/>
                <field name="requested_by_id"/>
                <field name="approved_by_id"/>
                <field name="attendance_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_overtime_request_search" model="ir.ui.view">
        <field name="name">hr.overtime.request.search</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="attendance_category"/>
                <field name="overtime_date"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Workers" name="worker" domain="[('attendance_category', '=', 'worker')]"/>
                <filter string="Office Staff" name="office" domain="[('attendance_category', '=', 'office')]"/>
            </search>
        </field>
    </record>

    <record id="view_hr_overtime_request_form" model="ir.ui.view">
        <field name="name">hr.overtime.request.form</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Overtime Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_revoke_approval" type="object" string="Revoke Approval" invisible="state != 'approved'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state not in ('submitted', 'rejected')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="employee_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="1"/>
                            <field name="attendance_category" readonly="1"/>
                            <field name="shift_template_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="requested_by_id" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="attendance_id" readonly="1"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="overtime_date" readonly="state != 'draft'"/>
                            <field name="requested_hours" readonly="state != 'draft'"/>
                            <field name="approved_hours" readonly="state == 'approved'"/>
                            <field name="duration_text" readonly="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Time Details">
                            <field name="start_time" readonly="state != 'draft'"/>
                            <field name="end_time" readonly="state != 'draft'"/>
                        </group>
                        <group string="Notes">
                            <field name="reason" placeholder="Explain why overtime is needed..." readonly="state not in ('draft', 'submitted')"/>
                            <field name="manager_note" placeholder="Manager approval note..." readonly="state not in ('submitted', 'approved')"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_overtime_request" model="ir.actions.act_window">
        <field name="name">Overtime Requests</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_overtime_request_search"/>
    </record>

    <record id="view_hr_attendance_overtime_register" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.register.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Overtime Register">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="overtime_hours" widget="float_time"/>
                <field name="validated_overtime_hours" widget="float_time"/>
                <field name="manual_overtime_hours" widget="float_time"/>
                <field name="manual_overtime_request_id"/>
            </list>
        </field>
    </record>

    <record id="action_hr_attendance_overtime_register" model="ir.actions.act_window">
        <field name="name">Overtime Register</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_attendance_overtime_register"/>
        <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="domain">['|', '|', ('overtime_hours', '&gt;', 0), ('validated_overtime_hours', '&gt;', 0), ('manual_overtime_hours', '&gt;', 0)]</field>
        <field name="context">{'search_default_employee': 1}</field>
    </record>
</odoo>
