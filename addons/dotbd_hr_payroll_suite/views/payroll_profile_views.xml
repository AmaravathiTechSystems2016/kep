<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dotbd_hr_payroll_profile_tree" model="ir.ui.view">
        <field name="name">dotbd.hr.payroll.profile.tree</field>
        <field name="model">dotbd.hr.payroll.profile</field>
        <field name="arch" type="xml">
            <list string="Payroll Profiles" default_order="company_id, attendance_category, name">
                <field name="name"/>
                <field name="company_id"/>
                <field name="attendance_category"/>
                <field name="payroll_structure_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dotbd_hr_payroll_profile_form" model="ir.ui.view">
        <field name="name">dotbd.hr.payroll.profile.form</field>
        <field name="model">dotbd.hr.payroll.profile</field>
        <field name="arch" type="xml">
            <form string="Payroll Profile">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Basic Salary Setup">
                            <field name="company_id"/>
                            <field name="attendance_category"/>
                            <field name="payroll_structure_id"/>
                            <field name="basic_mode"/>
                            <field name="basic_percentage"/>
                            <field name="hra_percentage"/>
                            <field name="active"/>
                        </group>
                        <group string="Statutory Deductions">
                            <field name="use_pf"/>
                            <field name="pf_percentage"/>
                            <field name="use_esi"/>
                            <field name="esi_percentage"/>
                        </group>
                    </group>
                    <group string="Allowances">
                        <group>
                            <field name="special_allowance"/>
                            <field name="conveyance_allowance"/>
                        </group>
                        <group>
                            <field name="washing_allowance"/>
                            <field name="medical_allowance"/>
                        </group>
                    </group>
                    <group string="Overtime">
                        <field name="overtime_multiplier"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Use this profile for payroll defaults and structure mapping."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dotbd_hr_payroll_profile" model="ir.actions.act_window">
        <field name="name">Payroll Profiles</field>
        <field name="res_model">dotbd.hr.payroll.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dotbd_hr_payroll_root"
              name="Payroll"
              parent="hr.menu_hr_root"
              sequence="45"
              groups="hr.group_hr_user"/>
    <menuitem id="menu_dotbd_hr_payroll_profiles"
              name="Payroll Profiles"
              parent="menu_dotbd_hr_payroll_root"
              action="action_dotbd_hr_payroll_profile"
              sequence="10"
              groups="hr.group_hr_user"/>
</odoo>
