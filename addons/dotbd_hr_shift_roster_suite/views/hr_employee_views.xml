<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_inherit_shift_roster" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.shift.roster</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="default_shift_template_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_tree_inherit_shift_roster" model="ir.ui.view">
        <field name="name">hr.employee.list.inherit.shift.roster</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="default_shift_template_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
