<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_shift_assignment_tree" model="ir.ui.view">
        <field name="name">hr.shift.assignment.list</field>
        <field name="model">hr.shift.assignment</field>
        <field name="arch" type="xml">
            <list string="Shift Assignments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="attendance_category"/>
                <field name="shift_template_id"/>
                <field name="rotation_mode"/>
                <field name="conflict_count" string="Conflicts"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="priority"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_shift_assignment_form" model="ir.ui.view">
        <field name="name">hr.shift.assignment.form</field>
        <field name="model">hr.shift.assignment</field>
        <field name="arch" type="xml">
            <form string="Shift Assignment">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Machine Operator - A Shift"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not conflict_count">
                        <field name="conflict_warning" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="shift_template_id"/>
                            <field name="attendance_category"/>
                            <field name="rotation_mode"/>
                            <field name="rotation_start_date" invisible="rotation_mode != 'cycle'"/>
                            <field name="rotation_cycle_days" invisible="rotation_mode != 'cycle'"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_conflicts" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="not conflict_count">
                            <field name="conflict_count" widget="statinfo" string="Conflicts"/>
                        </button>
                    </div>
                    <notebook>
                        <page string="Rotation" invisible="rotation_mode != 'cycle'">
                            <field name="rotation_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="shift_template_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_shift_assignment_search" model="ir.ui.view">
        <field name="name">hr.shift.assignment.search</field>
        <field name="model">hr.shift.assignment</field>
        <field name="arch" type="xml">
            <search string="Shift Assignments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="shift_template_id"/>
                <field name="attendance_category"/>
                <field name="company_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <separator string="Group By"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'attendance_category'}"/>
                    <filter string="Template" name="group_template" context="{'group_by': 'shift_template_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_shift_assignment" model="ir.actions.act_window">
        <field name="name">Shift Assignments</field>
        <field name="res_model">hr.shift.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_shift_assignment_search"/>
    </record>
</odoo>
