<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_shift_roster_revision_tree" model="ir.ui.view">
        <field name="name">hr.shift.roster.revision.list</field>
        <field name="model">hr.shift.roster.revision</field>
        <field name="arch" type="xml">
            <list string="Roster History">
                <field name="create_date"/>
                <field name="action_type"/>
                <field name="user_id"/>
                <field name="line_count"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_hr_shift_roster_revision_form" model="ir.ui.view">
        <field name="name">hr.shift.roster.revision.form</field>
        <field name="model">hr.shift.roster.revision</field>
        <field name="arch" type="xml">
            <form string="Roster Revision">
                <sheet>
                    <group>
                        <group>
                            <field name="roster_id" readonly="1"/>
                            <field name="action_type" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                            <field name="note" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Snapshot">
                            <field name="revision_line_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="employee_id"/>
                                    <field name="department_id"/>
                                    <field name="attendance_category"/>
                                    <field name="shift_template_id"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="break_duration" widget="float_time"/>
                                    <field name="is_weekly_off"/>
                                    <field name="is_public_holiday"/>
                                    <field name="holiday_name"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
