<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_subcontractor_rule_department_manager" model="ir.rule">
        <field name="name">Department Manager: Department Subcontractors</field>
        <field name="model_id" ref="model_hr_subcontractor"/>
        <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('dotbd_hr_access_control_suite.group_hr_department_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
