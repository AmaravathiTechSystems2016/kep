<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_subcontractor" model="ir.ui.view">
        <field name="name">hr.employee.form.subcontractor</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='payroll_group']/group[@name='contract']" position="after">
                    <group string="Subcontractor Assignment"
                       invisible="employee_type != 'contractor' and not subcontractor_id"
                       groups="hr.group_hr_user">
                    <field name="subcontractor_id"/>
                    <field name="subcontractor_status"/>
                    <field name="subcontractor_join_date"/>
                    <field name="subcontractor_end_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
