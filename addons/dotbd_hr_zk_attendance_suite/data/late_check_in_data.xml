<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Late Check-in -->
        <record id="seq_late_check_in" model="ir.sequence">
            <field name="name">Late Check-in Sequence</field>
            <field name="code">late.check.in</field>
            <field name="prefix">LATE</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cron Job for Creating Late Check-in Records -->
        <record forcecreate="True" id="ir_cron_create_late_check_in" model="ir.cron">
            <field name="name">Attendance: Late Check-in</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.late_check_in_records()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
