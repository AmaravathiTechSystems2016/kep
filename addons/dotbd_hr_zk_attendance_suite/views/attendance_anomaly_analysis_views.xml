<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Attendance Anomaly Analysis Tree View -->
    <record id="attendance_anomaly_analysis_view_tree" model="ir.ui.view">
        <field name="name">attendance.anomaly.analysis.view.tree</field>
        <field name="model">attendance.anomaly.analysis</field>
        <field name="arch" type="xml">
            <list string="Attendance Anomalies" create="false" delete="false"
                  decoration-danger="anomaly_type == 'missing_checkout'"
                  decoration-warning="anomaly_type == 'duplicate_checkin'"
                  decoration-info="anomaly_type == 'missing_checkin'">
                <field name="attendance_date"/>
                <field name="employee_id"/>
                <field name="anomaly_type"/>
                <field name="check_in_time"/>
                <field name="last_punch_time"/>
                <field name="checkin_count"/>
                <field name="checkout_count"/>
                <field name="total_punches"/>
                <field name="address_id"/>
            </list>
        </field>
    </record>

    <!-- Attendance Anomaly Analysis Search View -->
    <record id="attendance_anomaly_analysis_view_search" model="ir.ui.view">
        <field name="name">attendance.anomaly.analysis.view.search</field>
        <field name="model">attendance.anomaly.analysis</field>
        <field name="arch" type="xml">
            <search string="Search Attendance Anomalies">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="anomaly_type"/>
                <field name="address_id"/>
                <filter string="Missing Check-out" name="filter_missing_checkout"
                        domain="[('anomaly_type', '=', 'missing_checkout')]"/>
                <filter string="Duplicate Check-in" name="filter_duplicate_checkin"
                        domain="[('anomaly_type', '=', 'duplicate_checkin')]"/>
                <filter string="Missing Check-in" name="filter_missing_checkin"
                        domain="[('anomaly_type', '=', 'missing_checkin')]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('attendance_date', '=', context_today())]"/>
                <filter string="This Week" name="filter_this_week"
                        domain="[('attendance_date', '&gt;=', (context_today() - relativedelta(weeks=1)))]"/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('attendance_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Employee" name="group_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="Anomaly Type" name="group_anomaly_type"
                        context="{'group_by': 'anomaly_type'}"/>
                <filter string="Date" name="group_date"
                        context="{'group_by': 'attendance_date'}"/>
                <filter string="Working Address" name="group_address"
                        context="{'group_by': 'address_id'}"/>
            </search>
        </field>
    </record>

    <!-- Attendance Anomaly Analysis Pivot View -->
    <record id="attendance_anomaly_analysis_view_pivot" model="ir.ui.view">
        <field name="name">attendance.anomaly.analysis.view.pivot</field>
        <field name="model">attendance.anomaly.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Anomaly Analysis">
                <field name="employee_id" type="row"/>
                <field name="anomaly_type" type="col"/>
                <field name="total_punches" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Attendance Anomaly Analysis Graph View -->
    <record id="attendance_anomaly_analysis_view_graph" model="ir.ui.view">
        <field name="name">attendance.anomaly.analysis.view.graph</field>
        <field name="model">attendance.anomaly.analysis</field>
        <field name="arch" type="xml">
            <graph string="Attendance Anomaly Statistics" type="bar" stacked="True">
                <field name="anomaly_type"/>
                <field name="employee_id"/>
            </graph>
        </field>
    </record>

    <!-- Attendance Anomaly Analysis Calendar View -->
    <record id="attendance_anomaly_analysis_view_calendar" model="ir.ui.view">
        <field name="name">attendance.anomaly.analysis.view.calendar</field>
        <field name="model">attendance.anomaly.analysis</field>
        <field name="arch" type="xml">
            <calendar string="Attendance Anomalies Calendar"
                      date_start="attendance_date"
                      color="anomaly_type"
                      event_open_popup="true"
                      mode="month">
                <field name="employee_id"/>
                <field name="anomaly_type"/>
            </calendar>
        </field>
    </record>

    <!-- Attendance Anomaly Dashboard (Form View for Summary) -->
    <record id="attendance_anomaly_analysis_view_form" model="ir.ui.view">
        <field name="name">attendance.anomaly.analysis.view.form</field>
        <field name="model">attendance.anomaly.analysis</field>
        <field name="arch" type="xml">
            <form string="Attendance Anomaly Details" create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="attendance_date"/>
                            <field name="anomaly_type"/>
                            <field name="address_id"/>
                        </group>
                        <group>
                            <field name="check_in_time"/>
                            <field name="last_punch_time"/>
                            <field name="total_punches"/>
                            <field name="checkin_count"/>
                            <field name="checkout_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Punch Details">
                            <group>
                                <group string="Statistics">
                                    <field name="total_punches" readonly="1"/>
                                    <field name="checkin_count" readonly="1"/>
                                    <field name="checkout_count" readonly="1"/>
                                </group>
                                <group string="Time Details">
                                    <field name="check_in_time" readonly="1"/>
                                    <field name="last_punch_time" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Anomaly Analysis Action -->
    <record id="attendance_anomaly_analysis_action" model="ir.actions.act_window">
        <field name="name">Attendance Anomaly Analysis</field>
        <field name="res_model">attendance.anomaly.analysis</field>
        <field name="view_mode">graph,pivot,list,calendar,form</field>
        <field name="context">{
            'search_default_filter_this_month': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance anomalies found!
            </p>
            <p>
                This page helps you identify attendance issues such as:
                <ul>
                    <li><strong>Missing Check-out:</strong> Employee checked in but forgot to check out</li>
                    <li><strong>Duplicate Check-in:</strong> Employee checked in multiple times without proper check-out</li>
                    <li><strong>Missing Check-in:</strong> Employee has check-out record but no check-in</li>
                </ul>
            </p>
        </field>
    </record>

</odoo>
