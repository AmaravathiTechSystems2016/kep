<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Attendance Report Wizard Form View -->
    <record id="attendance_report_wizard_view_form" model="ir.ui.view">
        <field name="name">attendance.report.wizard.view.form</field>
        <field name="model">attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Attendance Report">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="report_type"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>

                <group string="Generated Report" invisible="state != 'done'">
                    <field name="report_file" filename="report_filename"/>
                    <field name="report_filename" invisible="1"/>
                </group>

                <field name="state" invisible="1"/>

                <footer>
                    <button string="Generate Report" name="action_generate_report"
                            type="object" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Download" name="action_download_report"
                            type="object" class="btn-success"
                            invisible="state != 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Attendance Report Wizard Action -->
    <record id="attendance_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Generate Attendance Report</field>
        <field name="res_model">attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add Menu Item for Report Generation -->
    <menuitem id="attendance_report_wizard_menu"
              name="Generate Report"
              action="attendance_report_wizard_action"
              parent="biometric_device_details_menu"
              groups="hr_attendance.group_hr_attendance_officer"
              sequence="25"/>
</odoo>
