<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Daily attendance list view-->
    <record id="daily_attendance_view_list" model="ir.ui.view">
        <field name="name">daily.attendance.view.list</field>
        <field name="model">daily.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" create="false" delete="false">
                <field name="punching_day"/>
                <field name="employee_id"/>
                <field name="device_id" optional="show"/>
                <field name="punch_type" optional="show"/>
                <field name="odoo_punch_type"/>
                <field name="attendance_type" optional="show"/>
                <field name="punching_time"/>
                <field name="address_id" optional="show"/>
            </list>
        </field>
    </record>
    <!--    Attendance analysis action-->
    <record id="daily_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">daily.attendance</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
    </record>

    <!--    Attendance analysis search view-->
    <record id="daily_attendance_view_search" model="ir.ui.view">
        <field name="name">daily.attendance.view.search</field>
        <field name="model">daily.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance Analysis">
                <field name="employee_id"/>
                <field name="device_id"/>
                <filter string="Date" name="filter_date" date="punching_day"/>
                <separator/>
                <filter string="Complete Cycle" name="filter_complete_cycle" domain="[('is_complete_cycle', '=', True)]"/>
                <filter string="Incomplete Cycle" name="filter_incomplete_cycle" domain="[('is_complete_cycle', '=', False)]"/>
                
                <group>
                    <filter string="Employee" name="group_by_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Source Device" name="group_by_device" context="{'group_by':'device_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by':'attendance_type'}"/>
                    <filter string="Cycle Status" name="group_by_cycle_status" context="{'group_by':'is_complete_cycle'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
