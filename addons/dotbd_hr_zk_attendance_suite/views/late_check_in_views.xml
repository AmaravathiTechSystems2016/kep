<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Late Check-in Search View with Filters -->
    <record id="late_check_in_view_search" model="ir.ui.view">
        <field name="name">late.check.in.view.search</field>
        <field name="model">late.check.in</field>
        <field name="arch" type="xml">
            <search string="Search Late check-in records">
                <field name="employee_id"/>
                <field name="date"/>
                <separator/>
                <filter string="Today" name="filter_today" domain="[('date', '=', context_today())]"/>
                <filter string="This Month" name="filter_this_month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Employee" name="group_employee" domain="[]"
                        context="{'group_by':'employee_id'}"/>
                <filter string="Date" name="group_date" domain="[]"
                        context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <!-- Late Check-in List View -->
    <record id="late_check_in_view_tree" model="ir.ui.view">
        <field name="name">late.check.in.view.tree</field>
        <field name="model">late.check.in</field>
        <field name="arch" type="xml">
            <list string="Late Check-in Records"
                  decoration-info="state=='draft'"
                  decoration-success="state=='approved'"
                  decoration-danger="state=='refused'"
                  decoration-muted="state=='deducted'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="actual_late_minutes" string="Actual Late (min)"/>
                <field name="late_minutes" string="Counted Late (min)"/>
                <field name="penalty_amount" sum="Total Penalty"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-success="state=='approved'"
                       decoration-danger="state=='refused'"
                       decoration-muted="state=='deducted'"/>
            </list>
        </field>
    </record>

    <!-- Late Check-in Form View -->
    <record id="late_check_in_view_form" model="ir.ui.view">
        <field name="name">late.check.in.view.form</field>
        <field name="model">late.check.in</field>
        <field name="arch" type="xml">
            <form string="Late Check-in" create="false">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_reject" string="Refuse" type="object"
                            invisible="state != 'draft'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft' or state == 'deducted'"
                            groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,deducted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(hr_attendance.hr_attendance_action)d" type="action"
                                class="oe_stat_button" icon="fa-calendar-check-o"
                                context="{'search_default_employee_id': employee_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Attendance</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1" placeholder="Reference ...."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="attendance_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="actual_late_minutes" readonly="1"/>
                            <field name="late_minutes" readonly="1"/>
                            <field name="penalty_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Add notes or justification..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Late Check-in Kanban View -->
    <record id="late_check_in_view_kanban" model="ir.ui.view">
        <field name="name">late.check.in.view.kanban</field>
        <field name="model">late.check.in</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="late_minutes"/>
                <field name="penalty_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6">
                                    <strong><field name="employee_id"/></strong>
                                </div>
                                <div class="col-6 text-end">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span class="text-muted"><field name="date"/></span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-6">
                                    <i class="fa fa-clock-o" title="Late Minutes"/> <field name="late_minutes"/> min
                                </div>
                                <div class="col-6 text-end">
                                    <strong><field name="penalty_amount"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Late Check-in Action -->
    <record id="late_check_in_action" model="ir.actions.act_window">
        <field name="name">Late Check-in</field>
        <field name="res_model">late.check.in</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_current_month': 1, 'search_default_group_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No late check-in records yet
            </p>
            <p>
                Late check-in records are created automatically when employees arrive late.
            </p>
        </field>
    </record>

    <!-- Late Check-in Menu -->
    <menuitem id="menu_late_check_in"
              name="Late Check-in"
              action="late_check_in_action"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="21"
              groups="hr.group_hr_user"/>
</odoo>
