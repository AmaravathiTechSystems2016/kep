<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================== ZK MACHINE ATTENDANCE LIST VIEW ==================== -->
    <record id="zk_machine_attendance_view_list" model="ir.ui.view">
        <field name="name">zk.machine.attendance.view.list</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <list string="Biometric Attendance Raw Data" create="false">
                <field name="punching_time"/>
                <field name="employee_id"/>
                <field name="device_id" optional="show"/>
                <field name="device_id_num"/>
                <field name="odoo_punch_type" string="Attendance Action"/>
                <field name="punch_type" string="Device Punch Type" optional="hide"/>
                <field name="attendance_type"/>
                <field name="address_id" optional="hide"/>
                <field name="hr_attendance_id" optional="hide"/>
                <field name="processed" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- ==================== ZK MACHINE ATTENDANCE FORM VIEW ==================== -->
    <record id="zk_machine_attendance_view_form" model="ir.ui.view">
        <field name="name">zk.machine.attendance.view.form</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <form string="Biometric Punch Record" create="false">
                <sheet>
                    <group>
                        <group string="Employee Info">
                            <field name="employee_id"/>
                            <field name="device_id_num"/>
                            <field name="punching_time"/>
                        </group>
                        <group string="Device &amp; Type">
                            <field name="device_id"/>
                            <field name="odoo_punch_type" string="Attendance Action"/>
                            <field name="punch_type" string="Device Punch Type"/>
                            <field name="attendance_type"/>
                            <field name="address_id"/>
                        </group>
                    </group>
                    <group string="Processing">
                        <field name="hr_attendance_id"/>
                        <field name="processed"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="zk_machine_attendance_view_search" model="ir.ui.view">
        <field name="name">zk.machine.attendance.view.search</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance Records">
                <field name="employee_id" string="Employee"/>
                <field name="device_id" string="Device"/>
                <field name="device_id_num" string="Device User ID"/>
                <filter name="filter_today" string="Today"
                        domain="[('punching_time', '&gt;=', (context_today()).strftime('%%Y-%%m-%%d 00:00:00'))]"/>
                <filter name="filter_this_week" string="This Week"
                        domain="[('punching_time', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <filter name="filter_odoo_checkin" string="Check In"
                        domain="[('odoo_punch_type', '=', 'check_in')]"/>
                <filter name="filter_odoo_checkout" string="Check Out"
                        domain="[('odoo_punch_type', '=', 'check_out')]"/>
                <separator/>
                <filter name="filter_checkin" string="Check In"
                        domain="[('punch_type', '=', '0')]"/>
                <filter name="filter_checkout" string="Check Out"
                        domain="[('punch_type', '=', '1')]"/>
                <separator/>
                <filter name="filter_processed" string="Processed"
                        domain="[('processed', '=', True)]"/>
                <filter name="filter_unprocessed" string="Not Processed"
                        domain="[('processed', '=', False)]"/>
                <separator/>
                <filter name="group_by_device" string="Device"
                        context="{'group_by': 'device_id'}"/>
                <filter name="group_by_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter name="group_by_odoo_punch_type" string="Attendance Action"
                        context="{'group_by': 'odoo_punch_type'}"/>
                <filter name="group_by_punch_type" string="Device Punch Type"
                        context="{'group_by': 'punch_type'}"/>
                <filter name="group_by_day" string="Day"
                        context="{'group_by': 'punching_time:day'}"/>
            </search>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_zk_machine_attendance" model="ir.actions.act_window">
        <field name="name">Raw Biometric Data</field>
        <field name="res_model">zk.machine.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No biometric attendance records yet
            </p>
            <p>
                Raw attendance punches from biometric devices will appear here
                after downloading attendance data.
            </p>
        </field>
    </record>

</odoo>
