<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Data file for Contribution Register-->
    <!-- These records provide initial defaults; payroll administrators maintain
         the formulas from the Salary Rules menu after installation. -->
    <data noupdate="1">
        <record id="contribution_register_employees" model="hr.contribution.register">
            <field name="name">Employees</field>
            <field name="partner_id" eval="False"/>
        </record>
        <record id="BASIC" model="hr.salary.rule.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
        </record>
        <record id="ALW" model="hr.salary.rule.category">
            <field name="name">Allowance</field>
            <field name="code">ALW</field>
        </record>
        <record id="GROSS" model="hr.salary.rule.category">
            <field name="name">Gross</field>
            <field name="code">GROSS</field>
        </record>
        <record id="DED" model="hr.salary.rule.category">
            <field name="name">Deduction</field>
            <field name="code">DED</field>
        </record>
        <record id="NET" model="hr.salary.rule.category">
            <field name="name">Net</field>
            <field name="code">NET</field>
        </record>
        <record id="COMP" model="hr.salary.rule.category">
            <field name="name">Company Contribution</field>
            <field name="code">COMP</field>
        </record>
        <record id="HRA" model="hr.salary.rule.category">
            <field name="name">House Rent Allowance</field>
            <field name="code">HRA</field>
            <field name="parent_id" ref="ALW"/>
        </record>
         <record id="DA" model="hr.salary.rule.category">
            <field name="name">Dearness Allowance</field>
            <field name="code">DA</field>
            <field name="parent_id" ref="ALW"/>
        </record>
         <record id="Travel" model="hr.salary.rule.category">
            <field name="name">Travel Allowance</field>
            <field name="code">Travel</field>
            <field name="parent_id" ref="ALW"/>
        </record>
         <record id="Meal" model="hr.salary.rule.category">
            <field name="name">Meal Allowance</field>
            <field name="code">Meal</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="Medical" model="hr.salary.rule.category">
            <field name="name">Medical Allowance</field>
            <field name="code">Medical</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="Other" model="hr.salary.rule.category">
            <field name="name">Other Allowance</field>
            <field name="code">Other</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="hr_rule_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="sequence" eval="1"/>
            <field name="code">BASIC</field>
            <field name="category_id" ref="hr_payroll_community.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage * contract.basic_percentage / 100.0</field>
        </record>
        <record id="hr_rule_taxable" model="hr.salary.rule">
            <field name="name">Gross</field>
            <field name="sequence" eval="100"/>
            <field name="code">GROSS</field>
            <field name="category_id" ref="hr_payroll_community.GROSS"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
        </record>
        <record id="hr_rule_net" model="hr.salary.rule">
            <field name="name">Net Salary</field>
            <field name="sequence" eval="200"/>
            <field name="code">NET</field>
            <field name="category_id" ref="hr_payroll_community.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.GROSS + categories.DED</field>
            <field name="register_id" ref="contribution_register_employees"/>
        </record>
        <record id="hr_rule_hra" model="hr.salary.rule">
            <field name="name">House Rent Allowance</field>
            <field name="sequence" eval="1"/>
            <field name="code">HRA</field>
            <field name="category_id" ref="hr_payroll_community.HRA"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage * contract.hra_percentage / 100.0</field>
        </record>
        <record id="hr_rule_da" model="hr.salary.rule">
            <field name="name">Dearness Allowance</field>
            <field name="sequence" eval="1"/>
            <field name="code">DA</field>
            <field name="category_id" ref="hr_payroll_community.DA"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.da</field>
        </record>
        <record id="hr_rule_travel" model="hr.salary.rule">
            <field name="name">Travel Allowance</field>
            <field name="sequence" eval="1"/>
            <field name="code">Travel</field>
            <field name="category_id" ref="hr_payroll_community.Travel"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.travel_allowance</field>
        </record>
        <record id="hr_rule_meal" model="hr.salary.rule">
            <field name="name">Meal Allowance</field>
            <field name="sequence" eval="1"/>
            <field name="code">Meal</field>
            <field name="category_id" ref="hr_payroll_community.Meal"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.meal_allowance</field>
        </record>
        <record id="hr_rule_medical" model="hr.salary.rule">
            <field name="name">Medical Allowance</field>
            <field name="sequence" eval="1"/>
            <field name="code">Medical</field>
            <field name="category_id" ref="hr_payroll_community.Medical"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.medical_allowance</field>
        </record>
        <record id="hr_rule_other" model="hr.salary.rule">
            <field name="name">Other Allowance</field>
            <field name="sequence" eval="1"/>
            <field name="code">Other</field>
            <field name="category_id" ref="hr_payroll_community.Other"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.other_allowance</field>
        </record>
        <record id="hr_rule_overtime" model="hr.salary.rule">
            <field name="name">Overtime Allowance</field>
            <field name="sequence" eval="110"/>
            <field name="code">OT</field>
            <field name="category_id" ref="hr_payroll_community.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
ot_line = worked_days.OT
ot_hours = ot_line.number_of_hours if ot_line else 0.0
calendar_days = (payslip.date_to - payslip.date_from).days + 1
hours_per_day = getattr(contract.resource_calendar_id, 'hours_per_day', 0.0) or 0.0
multiplier = getattr(contract, 'overtime_multiplier', 0.0) or 0.0
if calendar_days and hours_per_day and ot_hours and multiplier:
    daily_gross = categories.GROSS / calendar_days
    hourly_gross = daily_gross / hours_per_day
    result = ot_hours * hourly_gross * multiplier
else:
    result = 0.0</field>
        </record>
        <record id="hr_rule_unpaid" model="hr.salary.rule">
            <field name="name">Unpaid</field>
            <field name="sequence" eval="1"/>
            <field name="code">UNPAID</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(GLOBAL * (contract.wage / 30.0))</field>
        </record>
        <record id="hr_provident_fund_register" model="hr.contribution.register">
            <field name="name">Provident Fund Register</field>
        </record>
        <record id="hr_salary_rule_provident_fund1" model="hr.salary.rule">
            <field name="amount_select">code</field>
            <field name="sequence" eval="120"/>
            <field eval="-12.5" name="amount_percentage"/>
            <field name="amount_python_compute">pf_wages = min(categories.BASIC + categories.DA, contract.pf_wage_ceiling); result = -(pf_wages * contract.pf_rate / 100.0)</field>
            <field name="code">PF</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="register_id" ref="hr_provident_fund_register"/>
            <field name="name">Provident Fund</field>
        </record>
        <record id="hr_esi_register" model="hr.contribution.register">
            <field name="name">ESI Register</field>
        </record>
        <record id="hr_pt_register" model="hr.contribution.register">
            <field name="name">Professional Tax Register</field>
        </record>
        <record id="hr_salary_rule_pt" model="hr.salary.rule">
            <field name="amount_select">code</field>
            <field name="sequence" eval="130"/>
            <field name="code">PT</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="register_id" ref="hr_pt_register"/>
            <field name="name">Professional Tax</field>
            <field name="condition_select">none</field>
            <field name="amount_python_compute">result = -float(getattr(contract, 'professional_tax', 0.0) or 0.0)</field>
        </record>
        <record id="hr_salary_rule_esi1" model="hr.salary.rule">
            <field name="amount_select">code</field>
            <field name="sequence" eval="125"/>
            <field name="code">ESI</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="register_id" ref="hr_esi_register"/>
            <field name="name">Employee State Insurance</field>
            <field name="condition_select">none</field>
            <field name="condition_python">result = True</field>
            <field name="amount_python_compute">result = -(float(getattr(contract, 'wage', 0.0) or 0.0) * (float(getattr(contract, 'esi_employee_rate', 0.0) or 0.0) / 100.0))</field>
        </record>
        <!-- Salary Structure -->
        <record id="structure_base" model="hr.payroll.structure">
            <field name="code">BASE</field>
            <field name="name">Base for new structures</field>
            <field eval="[(6, 0, [ref('hr_rule_basic'), ref('hr_rule_taxable'),ref('hr_rule_net')])]" name="rule_ids"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="structure_worker" model="hr.payroll.structure">
            <field name="code">WORKER</field>
            <field name="name">Manufacturing Worker</field>
            <field name="parent_id" ref="structure_base"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="rule_ids" eval="[(6, 0, [
                ref('hr_rule_basic'),
                ref('hr_rule_hra'),
                ref('hr_rule_da'),
                ref('hr_rule_meal'),
                ref('hr_rule_medical'),
                ref('hr_rule_other'),
                ref('hr_rule_travel'),
                ref('hr_rule_unpaid'),
                ref('hr_salary_rule_provident_fund1'),
                ref('hr_salary_rule_esi1'),
                ref('hr_salary_rule_pt'),
                ref('hr_rule_taxable'),
                ref('hr_rule_net'),
            ])]"/>
        </record>

        <record id="structure_office" model="hr.payroll.structure">
            <field name="code">OFFICE</field>
            <field name="name">Office Staff</field>
            <field name="parent_id" ref="structure_base"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="rule_ids" eval="[(6, 0, [
                ref('hr_rule_basic'),
                ref('hr_rule_hra'),
                ref('hr_rule_meal'),
                ref('hr_rule_travel'),
                ref('hr_rule_medical'),
                ref('hr_rule_other'),
                ref('hr_rule_unpaid'),
                ref('hr_salary_rule_provident_fund1'),
                ref('hr_salary_rule_esi1'),
                ref('hr_salary_rule_pt'),
                ref('hr_rule_taxable'),
                ref('hr_rule_net'),
            ])]"/>
        </record>

        <!-- Decimal Precision -->
        <record forcecreate="True" id="decimal_payroll" model="decimal.precision">
            <field name="name">Payroll</field>
            <field name="digits">2</field>
        </record>
        <record forcecreate="True" id="decimal_payroll_rate" model="decimal.precision">
            <field name="name">Payroll Rate</field>
            <field name="digits">4</field>
        </record>
    </data>
</odoo>
