<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslipdetails">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="summary" t-value="get_summary(o)"/>
                    <t t-set="report_data" t-value="get_report_data(o)"/>
                    <div class="page payslip">
                        <style>
                            .payslip { color: #000000; font-family: Arial, sans-serif !important; font-size: 12px !important; line-height: 1.15; }
                            .payslip * { font-family: Arial, sans-serif !important; }
                            .payslip .company-header, .payslip .info-table, .payslip .salary-table, .payslip .closing-table { border-collapse: collapse; table-layout: fixed; width: 100%; }
                            .payslip .company-header td, .payslip .info-table td, .payslip .salary-table th, .payslip .salary-table td, .payslip .closing-table td { border: 1px solid #000000; padding: 4px 5px; vertical-align: middle; }
                            .payslip .company-header .logo-cell { text-align: center; width: 13%; }
                            .payslip .company-header .logo-cell img { max-height: 32px; max-width: 105px; }
                            .payslip .company-name { background: #dceaf3; font-family: Georgia, serif !important; font-size: 22px !important; font-weight: 700; text-align: center; }
                            .payslip .company-address { background: #e2f0d9; font-family: Georgia, serif !important; font-size: 14px !important; text-align: center; }
                            .payslip .report-title { color: #7030a0; font-size: 17px !important; font-weight: 700; padding: 4px; text-align: center; }
                            .payslip .info-table td:nth-child(1), .payslip .info-table td:nth-child(3) { background: #edf3e5; font-weight: 700; width: 25%; }
                            .payslip .info-table td:nth-child(2), .payslip .info-table td:nth-child(4) { width: 25%; }
                            .payslip .salary-table { margin-top: 0; }
                            .payslip .salary-table th, .payslip .salary-table td { font-size: 12px !important; }
                            .payslip .salary-table th { font-weight: 700; }
                            .payslip .salary-table .earning-head, .payslip .salary-table .earning-label { background: #e2f0d9; }
                            .payslip .salary-table .deduction-head, .payslip .salary-table .deduction-label { background: #fce4d6; }
                            .payslip .salary-table .money, .payslip .closing-table .money { text-align: right; }
                            .payslip .salary-table .total, .payslip .closing-table .total { font-weight: 700; }
                            .payslip .closing-table { margin-top: 0; }
                            .payslip .closing-table .label { font-weight: 700; width: 25%; }
                            .payslip .closing-table .words { width: 75%; }
                            .payslip .footer-note { border: 1px solid #000000; font-size: 13px !important; padding: 5px; text-align: center; }
                        </style>
                        <table class="company-header">
                            <tr>
                                <td class="logo-cell"><img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"/></td>
                                <td class="company-name" colspan="3" t-esc="o.company_id.name"/>
                            </tr>
                            <tr><td class="company-address" colspan="4" t-esc="o.company_id.partner_id.contact_address"/></tr>
                            <tr><td class="report-title" colspan="4">PAY SLIP FOR THE MONTH OF <span t-esc="report_data['month_label']"/></td></tr>
                        </table>
                        <table class="info-table">
                            <tr><td>Name:</td><td t-esc="o.employee_id.name"/><td>Employee No:</td><td t-esc="report_data['employee_number']"/></tr>
                            <tr><td>Joining Date:</td><td><span t-if="o.employee_id.joining_date" t-field="o.employee_id.joining_date"/><span t-else="">Not provided</span></td><td>Bank Name:</td><td t-esc="report_data['bank_name']"/></tr>
                            <tr><td>Designation:</td><td t-esc="o.employee_id.job_id.name if o.employee_id.job_id else 'Not provided'"/><td>Bank Account No:</td><td t-esc="report_data['bank_account']"/></tr>
                            <tr><td>Department:</td><td t-esc="report_data['department']"/><td>IFSC Code:</td><td t-esc="report_data['ifsc']"/></tr>
                            <tr><td>Location:</td><td t-esc="report_data['location']"/><td>ESI No:</td><td t-esc="report_data['esi_number']"/></tr>
                            <tr><td>EMP Effective Work Days:</td><td t-esc="summary['worked_days']"/><td>PF UAN:</td><td><span t-if="o.employee_id.uan_number" t-field="o.employee_id.uan_number"/><span t-else="">Not provided</span></td></tr>
                            <tr><td>LOP Days:</td><td t-esc="summary['lop_days']"/><td></td><td></td></tr>
                        </table>
                        <table class="salary-table">
                            <colgroup><col style="width: 25%;"/><col style="width: 12.5%;"/><col style="width: 12.5%;"/><col style="width: 25%;"/><col style="width: 25%;"/></colgroup>
                            <tr><th class="earning-head">Earnings</th><th class="earning-head">Master</th><th class="earning-head">Actual</th><th class="deduction-head">Deductions</th><th class="deduction-head">Actual</th></tr>
                            <tr><td class="earning-label">Basic + DA</td><td class="money" t-esc="summary['master_basic_da']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="money" t-esc="summary['basic_da']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="deduction-label">PF</td><td class="money" t-esc="summary['pf']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                            <tr><td class="earning-label">HRA</td><td class="money" t-esc="summary['master_hra']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="money" t-esc="summary['hra']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="deduction-label">ESI</td><td class="money" t-esc="summary['esi']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                            <tr><td class="earning-label">Medical &amp; Other</td><td class="money" t-esc="summary['master_medical_other']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="money" t-esc="summary['medical_other']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="deduction-label">Professional Tax</td><td class="money" t-esc="summary['pt']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                            <tr><td class="earning-label">Conveyance</td><td class="money" t-esc="summary['master_conveyance']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="money" t-esc="summary['conveyance']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="deduction-label">TDS</td><td class="money" t-esc="summary['tds']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                            <tr><td class="earning-label">Arrears</td><td></td><td class="money" t-esc="summary['arrears']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="deduction-label">Other Deductions</td><td class="money" t-esc="summary['other_deductions']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                            <tr><td class="earning-label"></td><td></td><td></td><td class="deduction-label">Salary Advance</td><td class="money" t-esc="summary['salary_advance']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                            <tr class="total"><td class="earning-label">Total Earnings</td><td class="money" t-esc="summary['master_total']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="money" t-esc="summary['gross']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/><td class="deduction-label">Total Deductions</td><td class="money" t-esc="summary['total_deductions']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                        </table>
                        <table class="closing-table">
                            <tr class="total"><td class="label">Net Salary</td><td class="money" colspan="3" t-esc="summary['net']" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></tr>
                            <tr><td class="label">Salary in Words</td><td class="words" colspan="3" t-esc="summary['salary_in_words']"/></tr>
                            <tr><td class="label">GRATUITY</td><td colspan="3">Not applicable</td></tr>
                        </table>
                        <div class="footer-note">This is a system generated payslip and does not require signature.</div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
