<odoo>
    <!-- Odoo 19: groups are attached to a privilege, which belongs to a category -->
    <record id="privilege_emp_performance_appraisal" model="res.groups.privilege">
        <field name="name">Employee Performance Appraisal</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- ============================================================
         GROUPS
         ============================================================ -->
    <record id="group_performance_appraisal_appraiser" model="res.groups">
        <field name="name">Appraiser (score only)</field>
        <field name="privilege_id" ref="privilege_emp_performance_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can only fill in the Obtained Score of the evaluation
            lines of appraisals where they are set as the appraiser, and only while
            the appraisal is still in Draft. Combining this group with Viewer widens
            what they can *see*, never what they can *change*; only the Performance
            Appraisal Manager group lifts the restriction.</field>
    </record>

    <record id="group_performance_appraisal_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_emp_performance_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_performance_appraisal_manager" model="res.groups">
        <field name="name">Performance Appraisal Manager</field>
        <field name="privilege_id" ref="privilege_emp_performance_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('mj_appraisal.group_performance_appraisal_viewer'))]"/>
    </record>

    <!-- ============================================================
         RECORD RULES

         Access rights (ir.model.access) and record rules are both OR-ed over
         all the groups a user belongs to, so a restriction can never be
         expressed by *adding* a group - a more permissive group always wins.

         The rules below therefore split by operation:

           * READ  is granted broadly (Viewer / Manager see everything,
                   an Appraiser alone sees only what they must score).
           * WRITE is granted narrowly. The Appraiser rule is the only write
                   rule that group gets, so "Appraiser + Viewer" reads
                   everything but still writes only their own rows.
                   Managers get their own write-everything rule.

         Which *fields* may be written is not expressible here; that is
         enforced in models/appraisal_access_mixin.py.
         ============================================================ -->

    <!-- ===== performance.appraisal ===== -->
    <record id="rule_performance_appraisal_all" model="ir.rule">
        <field name="name">Performance Appraisal: read all</field>
        <field name="model_id" ref="model_performance_appraisal"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_viewer')),
                                    (4, ref('mj_appraisal.group_performance_appraisal_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_performance_appraisal_own_appraiser" model="ir.rule">
        <field name="name">Performance Appraisal: only the ones I appraise</field>
        <field name="model_id" ref="model_performance_appraisal"/>
        <field name="domain_force">[('performance_appraiser_ids.appraiser_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_appraiser'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_performance_appraisal_manager_write" model="ir.rule">
        <field name="name">Performance Appraisal: managers modify all</field>
        <field name="model_id" ref="model_performance_appraisal"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ===== performance.appraiser ===== -->
    <record id="rule_performance_appraiser_all" model="ir.rule">
        <field name="name">Performance Appraiser: read all</field>
        <field name="model_id" ref="model_performance_appraiser"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_viewer')),
                                    (4, ref('mj_appraisal.group_performance_appraisal_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_performance_appraiser_own" model="ir.rule">
        <field name="name">Performance Appraiser: only my own evaluations</field>
        <field name="model_id" ref="model_performance_appraiser"/>
        <field name="domain_force">[('appraiser_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_appraiser'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_performance_appraiser_manager_write" model="ir.rule">
        <field name="name">Performance Appraiser: managers modify all</field>
        <field name="model_id" ref="model_performance_appraiser"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ===== performance.appraiser.line ===== -->
    <record id="rule_performance_appraiser_line_all" model="ir.rule">
        <field name="name">Performance Appraiser Line: read all</field>
        <field name="model_id" ref="model_performance_appraiser_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_viewer')),
                                    (4, ref('mj_appraisal.group_performance_appraisal_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_performance_appraiser_line_own" model="ir.rule">
        <field name="name">Performance Appraiser Line: only my own evaluation lines</field>
        <field name="model_id" ref="model_performance_appraiser_line"/>
        <field name="domain_force">[('performance_appraiser_id.appraiser_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_appraiser'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_performance_appraiser_line_manager_write" model="ir.rule">
        <field name="name">Performance Appraiser Line: managers modify all</field>
        <field name="model_id" ref="model_performance_appraiser_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mj_appraisal.group_performance_appraisal_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
